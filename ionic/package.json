{
  "name": "event-check-in",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:android": "node scripts/test-android.mjs",
    "lint": "eslint .",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "sync": "npm run build && cap sync",
    "sync:android": "npm run build && cap sync android",
    "sync:ios": "npm run build && cap sync ios",
    "android": "npm run sync:android && cap open android",
    "ios": "npm run sync:ios && cap open ios",
    "android:run": "npm run sync:android && cap run android",
    "ios:run": "npm run sync:ios && cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@ionic/react": "9.0.9",
    "ionicons": "^8.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^9.20.1",
    "@playwright/test": "1.64.1",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "terser": "^5.16.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.24.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
